<?xml version="1.0" encoding="utf-8"?>
<!-- Styles for the home-screen widget (layout/inkleaf_widget.xml). -->
<resources>
    <!-- A quick-capture button: pencil-yellow pill with an ink outline. -->
    <style name="InkleafWidgetPill">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/widget_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#292B28</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- A pinned note, one line. -->
    <style name="InkleafWidgetPinned">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">#292B28</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
