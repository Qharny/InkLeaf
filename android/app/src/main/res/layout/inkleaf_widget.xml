<?xml version="1.0" encoding="utf-8"?>
<!-- Inkleaf home-screen widget: cream paper card, quick-capture pills, and
     up to three pinned notes. Filled in by InkleafWidgetProvider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inkleaf"
        android:textColor="#292B28"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/new_note"
            style="@style/InkleafWidgetPill"
            android:text="+ Note" />

        <TextView
            android:id="@+id/new_checklist"
            style="@style/InkleafWidgetPill"
            android:text="List" />

        <TextView
            android:id="@+id/new_recording"
            style="@style/InkleafWidgetPill"
            android:text="Voice" />

        <TextView
            android:id="@+id/new_scan"
            style="@style/InkleafWidgetPill"
            android:layout_marginEnd="0dp"
            android:text="Scan" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Pinned"
        android:textColor="#5A5C57"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/pinned_0"
        style="@style/InkleafWidgetPinned" />

    <TextView
        android:id="@+id/pinned_1"
        style="@style/InkleafWidgetPinned" />

    <TextView
        android:id="@+id/pinned_2"
        style="@style/InkleafWidgetPinned" />

    <TextView
        android:id="@+id/pinned_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Pin a note to keep it here"
        android:textColor="#8E8F88"
        android:textSize="13sp" />
</LinearLayout>
